# Public API base URL (accessible by browser client and SSR)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Internal API URL (optional for internal server-to-server container networks)
# INTERNAL_API_URL=http://backend:8000/api

# Meta Pixel (Facebook Pixel) Tracking ID
NEXT_PUBLIC_META_PIXEL_ID=1806216353748383

# Image Optimization Microservice (Server-only; NEVER use NEXT_PUBLIC_ prefix)
IMAGE_SERVICE_URL=http://127.0.0.1:8100
IMAGE_SERVICE_API_KEY=your_secure_service_key_here

